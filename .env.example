# Hermes Agent on Render: Environment Variables
#
# This file contains all environment variables needed for Hermes Agent
# with Google AI Studio (Gemma 4 31B IT) on Render Free Tier.
#
# SETUP OPTIONS:
# Option 1: Copy this file to .env and set values, then they load automatically
# Option 2: Set variables directly in Render Dashboard > Environment tab
#
# =============================================================================
# REQUIRED: Google AI Studio API Key
# =============================================================================
# Get your API key at: https://aistudio.google.com/app/apikey
# The free tier provides limited Gemma access; check AI Studio quotas
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# =============================================================================
# Container Boot Config (Render sets these automatically)
# =============================================================================
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000
HERMES_DASHBOARD_TUI=1

# Generated at first deploy - used for gateway authentication
HERMES_GATEWAY_TOKEN=generate_value_at_deploy

# =============================================================================
# Optional: OpenAI-Compatible API Server
# =============================================================================
# Enable to expose an OpenAI-compatible API for external integrations
# API_SERVER_ENABLED=false
# API_SERVER_KEY=your_api_server_key
# API_SERVER_HOST=0.0.0.0
# API_SERVER_CORS_ORIGINS=*

# =============================================================================
# Optional: Render MCP Server Integration
# =============================================================================
# Uncomment and add your Render API key for MCP server access
# Get your key at: https://dashboard.render.com/u/*/settings#api-keys
# RENDER_MCP_API_KEY=your_render_api_key_here

# =============================================================================
# Optional: Auxiliary Providers
# =============================================================================
# Vision model for image analysis and browser screenshots
# AUXILIARY_VISION_PROVIDER=gemini
# AUXILIARY_VISION_MODEL=gemini-2.0-flash

# Web extraction for fetching web content
# AUXILIARY_WEB_EXTRACT_PROVIDER=gemini
# AUXILIARY_WEB_EXTRACT_MODEL=gemini-2.0-flash

# =============================================================================
# Optional: Third-party Tool API Keys
# =============================================================================
# Tavily for web search
# TAVILY_API_KEY=your_tavily_key

# Exa for web search
# EXA_API_KEY=your_exa_key

# Firecrawl for web scraping
# FIRECRAWL_API_KEY=your_firecrawl_key

# Browserbase for cloud browser automation
# BROWSERBASE_API_KEY=your_browserbase_key

# GitHub for repository operations
# GITHUB_TOKEN=your_github_token

# =============================================================================
# Optional: Messaging Platforms
# =============================================================================
# Telegram Bot
# TELEGRAM_BOT_TOKEN=your_telegram_token

# Discord Bot
# DISCORD_BOT_TOKEN=your_discord_token

# Slack Bot
# SLACK_BOT_TOKEN=your_slack_bot_token
# SLACK_APP_TOKEN=your_slack_app_token
